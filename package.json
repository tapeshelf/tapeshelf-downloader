{
  "name": "tapeshelf-extension",
  "version": "1.0.0",
  "description": "Browser extension: download the video of any page to your computer, or save it to your shelf on tapeshelf",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "pack": "node build.mjs --zip",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "oxlint --type-aware src/ test/",
    "format": "prettier --write \"src/**/*.{ts,json,html,css}\" \"test/**/*.ts\" build.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,json,html,css}\" \"test/**/*.ts\" build.mjs",
    "test": "vitest run"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@fontsource-variable/golos-text": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@mediabunny/mp3-encoder": "1.62.1",
    "mediabunny": "1.62.1"
  }
}
